{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["bun", "node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": false,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "baseUrl": ".",
    "paths": {
      "@hivescape/core": ["packages/core/src/index.ts"],
      "@hivescape/render": ["packages/render/src/index.ts"],
      "@hivescape/runtime": ["packages/runtime/src/index.ts"],
      "@hivescape/runtime/*": ["packages/runtime/src/*"],
      "@hivescape/hivemind": ["packages/hivemind/src/index.ts"],
      "@hivemind/view-sdk": ["packages/hivemind/vendor/view-sdk/index.ts"]
    }
  },
  "include": ["packages/*/src", "packages/*/vendor", "scenes/*/src", "scenes/*/*.test.ts", "packages/*/test"]
}
